# development = Local PostgreSQL database in Docker (automatic)
# production = Remote database configured in DATABASE_URL
RACK_ENV=development

# DEV_DATABASE_URL: Local PostgreSQL database in Docker (for development)
DEV_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/fudo_development"

# DATABASE_URL: Remote database (for production)
# This URL is only used when RACK_ENV=production
DATABASE_URL="postgresql://your-username:your-password@your-database-host:5432/your-database-name"

JWT_SECRET="your-secret-key-here-change-in-production"
JWT_EXPIRATION=30 # minutes

EXTERNAL_PRODUCTS_URL="https://your-external-products-api.com/"

ERROR_BACKTRACE_LINES=10
SIMULATE_PROCESSING_DELAY=5
JOB_QUEUE_MAX_CAPACITY=10
MAX_USER_PENDING_JOBS=5

PORT=9292
HOST=0.0.0.0
API_PREFIX="/v1"